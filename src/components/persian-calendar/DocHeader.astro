---
// src/components/persian-calendar/DocHeader.astro
// Breadcrumb, title, reading time, last update and the page actions (copy as Markdown, view Markdown, GitHub).
import type { DocData } from '../../persian-calendar/content';
import { docsText, formatDate } from '../../persian-calendar/i18n';
import { markdownUrl, pageUrl } from '../../persian-calendar/pages';
import { githubUrl } from '../../persian-calendar/repo';

interface Props {
  doc: DocData;
  eyebrow?: string;
  /** Short line under the title */
  lead?: string;
}

const { doc, eyebrow, lead } = Astro.props;
const { lang, page } = doc;
const t = docsText[lang];
const breadcrumb = lang === 'fa' ? 'مسیر صفحه' : 'Breadcrumb';
// Path separator that leans with the reading direction
const separator = lang === 'fa' ? '\\' : '/';
const isLanguage = page.kind === 'language';
const github = isLanguage ? githubUrl(`implementations/${doc.language!.impl.dir}`) : githubUrl(doc.sources[0], 'edit');
const button =
  'inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/[0.04] px-3 py-1.5 text-xs font-semibold text-ink-200 transition-colors hover:border-brand-400/40 hover:bg-brand-400/10 hover:text-brand-100';
---

<header class="mb-8 border-b border-white/10 pb-7">
  <nav aria-label={breadcrumb} class="mb-5 text-xs text-ink-400">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li><a href={pageUrl('', lang)} class="hover:text-brand-200">{t.brand}</a></li>
      {
        isLanguage && (
          <>
            <li aria-hidden="true" class="text-ink-600">{separator}</li>
            <li><a href={pageUrl('implementations', lang)} class="hover:text-brand-200">{t.groups.code}</a></li>
          </>
        )
      }
      <li aria-hidden="true" class="text-ink-600">{separator}</li>
      <li><a href={pageUrl(page.slug, lang)} aria-current="page" class="text-ink-200">{doc.navTitle}</a></li>
    </ol>
  </nav>

  {eyebrow && <p class="mb-3 font-mono text-xs font-semibold uppercase tracking-[0.16em] text-brand-300">{eyebrow}</p>}
  <h1 class="slash text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-[2.6rem]">{doc.title}</h1>
  {lead && <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink-300">{lead}</p>}

  <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-ink-400">
    {
      !isLanguage && (
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <span>{t.readingTime(doc.minutes)}</span>
          <span aria-hidden="true">·</span>
          <span>
            {t.updated} <time datetime={doc.modified.toISOString()}>{formatDate(doc.modified, lang)}</time>
          </span>
        </p>
      )
    }
    <div class="flex flex-wrap gap-2 sm:ms-auto">
      <button type="button" class={button} data-copy-page={markdownUrl(page.slug, lang)} title={t.copyPageHint} hidden>
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="5" y="5" width="9" height="9" rx="2"></rect>
          <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"></path>
        </svg>
        <span data-label>{t.copyPage}</span>
      </button>
      <a href={markdownUrl(page.slug, lang)} class={button} title={t.viewMarkdownHint} type="text/markdown">
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="1.5" y="3.5" width="13" height="9" rx="2"></rect>
          <path d="M4 10V6l2 2 2-2v4M11 6v4m-1.5-1.5L11 10l1.5-1.5"></path>
        </svg>
        {t.viewMarkdown}
      </a>
      <slot name="actions" />
      <a href={github} class={button}>
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        {isLanguage ? t.viewOnGitHub : t.editOnGitHub}
      </a>
    </div>
  </div>
</header>
